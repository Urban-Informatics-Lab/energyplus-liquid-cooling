  Version,26.1;

  Timestep,6;

  SimulationControl,
    No,    !- Do Zone Sizing Calculation
    No,    !- Do System Sizing Calculation
    No,    !- Do Plant Sizing Calculation
    No,    !- Run Simulation for Sizing Periods
    Yes,   !- Run Simulation for Weather File Run Periods
    No,    !- Do HVAC Sizing Simulation for Sizing Periods
    1;     !- Maximum Number of HVAC Sizing Simulation Passes

  SizingPeriod:DesignDay,
    Tampa Summer DesignDay,  !- Name
    8,                       !- Month
    21,                      !- Day of Month
    SummerDesignDay,         !- Day Type
    33.9,                    !- Maximum Dry-Bulb Temperature {C}
    7.9,                     !- Daily Dry-Bulb Temperature Range {deltaC}
    DefaultMultipliers,      !- Dry-Bulb Temperature Range Modifier Type
    ,                        !- Dry-Bulb Temperature Range Modifier Day Schedule Name
    Wetbulb,                 !- Humidity Condition Type
    25.1,                    !- Wetbulb or DewPoint at Maximum Dry-Bulb {C}
    ,                        !- Humidity Condition Day Schedule Name
    ,                        !- Humidity Ratio at Maximum Dry-Bulb {kgWater/kgDryAir}
    ,                        !- Enthalpy at Maximum Dry-Bulb {J/kg}
    ,                        !- Daily Wet-Bulb Temperature Range {deltaC}
    101229,                  !- Barometric Pressure {Pa}
    3.1,                     !- Wind Speed {m/s}
    270,                     !- Wind Direction {deg}
    No,                      !- Rain Indicator
    No,                      !- Snow Indicator
    No,                      !- Daylight Saving Time Indicator
    ASHRAETau,               !- Solar Model Indicator
    ,                        !- Beam Solar Day Schedule Name
    ,                        !- Diffuse Solar Day Schedule Name
    0.491,                   !- ASHRAE Clear Sky Optical Depth for Beam Irradiance (taub) {dimensionless}
    2.016,                   !- ASHRAE Clear Sky Optical Depth for Diffuse Irradiance (taud) {dimensionless}
    ,                        !- Sky Clearness
    ,                        !- Maximum Number Warmup Days
    FullResetAtBeginEnvironment;  !- Begin Environment Reset Mode

  RunPeriod,
    Run Period 1,            !- Name
    1,                       !- Begin Month
    1,                       !- Begin Day of Month
    2026,                    !- Begin Year
    12,                      !- End Month
    31,                      !- End Day of Month
    2026,                    !- End Year
    Thursday,                !- Day of Week for Start Day
    No,                      !- Use Weather File Holidays and Special Days
    No,                      !- Use Weather File Daylight Saving Period
    No,                      !- Apply Weekend Holiday Rule
    Yes,                     !- Use Weather File Rain Indicators
    Yes;                     !- Use Weather File Snow Indicators

  HeatBalanceAlgorithm, ConductionTransferFunction, 200;
  SurfaceConvectionAlgorithm:Inside,  TARP;
  SurfaceConvectionAlgorithm:Outside, TARP;
  ShadowCalculation, PolygonClipping, Periodic, 20, 15000;

  Site:Location,
    Tampa-MacDill AFB_FL_USA,
    27.85, -82.52, -5, 8;

  Site:GroundTemperature:FCfactorMethod,
    24.2,18.9,15.7,13.6,15.5,17.1,21.2,26.9,27.6,27.9,27.4,26.2;

  GlobalGeometryRules,
    UpperLeftCorner, Counterclockwise, Relative, Relative, Relative;

  ! ── Schedules ─────────────────────────────────────────────

  ScheduleTypeLimits, Fractional, 0, 1, Continuous;
  ScheduleTypeLimits, Temperature,  ,  , Continuous, temperature;
  ScheduleTypeLimits, AnyNumber;

  Schedule:Constant, Always On Discrete,  AnyNumber, 1;
  Schedule:Constant, Always Off Discrete, AnyNumber, 0;

  ! Server power: always at 100 % (1.0)
  Schedule:Constant, ITE Power Schedule,  Fractional, 1.0;

  ! CPU load: ramps from 30% at midnight to 90% at noon, back to 30%
  Schedule:Compact,
    ITE CPU Load Schedule,
    Fractional,
    Through: 12/31,
    For: AllDays,
    Until: 06:00, 0.30,
    Until: 12:00, 0.90,
    Until: 18:00, 0.90,
    Until: 24:00, 0.30;

  ! Zone thermostat
  Schedule:Compact,
    DC Thermostat Schedule,
    AnyNumber,
    Through: 12/31, For: AllDays, Until: 24:00, 4;

  ScheduleTypeLimits, TstatLimits, 0, 4, DISCRETE;

  Schedule:Compact,
    DC HTGSETP, Temperature,
    Through: 12/31, For: AllDays, Until: 24:00, 15;

  Schedule:Compact,
    DC CLGSETP, Temperature,
    Through: 12/31, For: AllDays, Until: 24:00, 35;

  ! Warm-water FWS supply setpoint: 45°C
  Schedule:Compact,
    WW FWS Supply Temp Setpoint,
    Temperature,
    Through: 12/31, For: AllDays, Until: 24:00, 45.0;

