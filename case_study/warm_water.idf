  ! ── CPU Power curve: f(cpu_load, T_rack_sup) ──────────────
  ! Biquadratic: f = -0.035289 + 1.0·x + 0.0015684·y  (x=load, y=T_rack)
  ! Note: curve is calibrated at ~75°C rack supply; the linear T correction
  ! is small relative to the load term and remains valid across 65–85°C.
  Curve:Biquadratic,
    Curve Biquadratic 3,
    -0.035289, 1.0, 0, 0.0015684, 0, 0,
    0, 1.5, -10, 99;

  ! ── ElectricEquipment:ITE:LiquidCooled ───────────────────
  !
  !  Warm-water two-loop design (matches diagram: 80% liquid / 20% air):
  !    FWS supply    : 45°C   (Warm Water Loop, dry cooler)
  !    FWS return    : ~50°C  (ΔT ≈ 5°C at peak, 2.036 MW / (ρ·cₚ·5°C))
  !    Rack supply   : 47°C   (FWS supply + 2°C CDU approach)
  !    Rack return   : ~67°C  (Q_liq/(ṁ_rack·cₚ) ≈ 20°C rise at peak)
  !    xPU junction  : ~76°C  (within 110°C limit)
  !    CDU approach  : 2°C    (T_rack_sup − T_fws_sup = 47 − 45)
  !    FWS flow rate : 0.097 m³/s  (2.036 MW / (ρ·cₚ·5°C))
  !    Rack flow rate: 0.024 m³/s  (2.036 MW / (ρ·cₚ·20°C))
  !    Air leakage   : 20%  UPS eff: 94%
  !    NumUnits = 71 racks (~29 kW/rack); R_jc = 0.001 K/W (rack-level)
  !      → q_per_unit ≈ 29 kW, ΔT_junc ≈ 29°C, T_junc ≈ 76°C (within 110°C limit)

  ElectricEquipment:ITE:LiquidCooled,
    DC Warm Water ITE,        !- Name
    DataCenter,               !- Zone or Space Name
    Watts/Area,               !- Design Power Input Calculation Method
    ,                         !- Watts per Unit
    71,                       !- Number of Units  (~30 kW/rack, 2.14 MW total)
    3844.69356,               !- Watts per Floor Area {W/m2}
    DataCenter Equipment_SCH, !- Design Power Input Schedule Name
    Always On Discrete,       !- CPU Loading Schedule Name
    ,                         !- CPU Power Curve Name (blank = linear, no temp dependence)
    45.0,                     !- FWS Design Supply Temperature {C}
    0.097,                    !- FWS Design Volumetric Flow Rate {m3/s}  (2.036 MW / (ρ·cp·5°C))
    ITE FWS Inlet Node,       !- FWS Coolant Inlet Node Name
    ITE FWS Outlet Node,      !- FWS Coolant Outlet Node Name
    0.024,                    !- Rack Coolant Design Volumetric Flow Rate {m3/s}  (2.036 MW / (ρ·cp·20°C))
    47.0,                     !- Rack Coolant Design Supply Temperature {C}  (FWS 45°C + 2°C CDU approach)
    2.0,                      !- CDU Approach Temperature {deltaC}  (T_rack_sup − T_fws_sup = 47 − 45)
    0.001,                    !- Thermal Resistance Junction-to-Coolant {K/W}
    110.0,                    !- Maximum Junction Temperature {C}  (75°C supply + ~30°C rise ≈ 105°C)
    0.20,                     !- Air Side Heat Leakage Fraction (20% — moderate containment, no rear-door HX)
    0.94,                     !- UPS Efficiency
    1.0,                      !- Fraction of UPS Losses to Zone (UPS collocated in data hall)
    ITE-CPU,                  !- CPU End-Use Subcategory
    ITE-UPS;                  !- UPS End-Use Subcategory

  ! ── Zone HVAC: CRAH on the Room CHW loop ───────────────────
  !  June08: residual zone load with the INTENDED 20% air-side leakage:
  !    20% × 2143 kW server power = 429 kW
  !    UPS losses to zone (1/0.94−1)×2143 kW = 137 kW
  !    Lights + envelope          = ~4 kW
  !    → Peak residual ~566 kW (+ ~41 kW CRAH fan heat → ~607 kW coil load)
  !  Room CHW chiller re-sized 600 kW → 1000 kW to actually absorb this (see chiller).

  ZoneHVAC:EquipmentConnections,
    DataCenter ZN,
    DataCenter ZN Equipment List,
    DataCenter ZN Inlet Node List,
    DataCenter ZN Exhaust Node List,           !- Zone Air Exhaust Node or NodeList Name (CRAH inlet)
    DataCenter ZN Zone Air Node,
    DataCenter ZN Return Node List;

  NodeList, DataCenter ZN Inlet Node List,    DC CRAH Supply Air Node;
  NodeList, DataCenter ZN Exhaust Node List,  DC CRAH Air Inlet Node;
  NodeList, DataCenter ZN Return Node List,   DataCenter ZN Return Air Node;

  ZoneHVAC:EquipmentList,
    DataCenter ZN Equipment List,
    SequentialLoad,
    ZoneHVAC:FourPipeFanCoil, DC CRAH,
    1, 1, , ;

  Sizing:Zone,
    DataCenter ZN,
    SupplyAirTemperature, 18.0, 11.11,
    SupplyAirTemperature, 40.0, 11.11,
    0.009, 0.004,
    , , , DesignDay, 0, 0, 0, 0,
    DesignDay, 0, 0, 0, 0;

  ZoneHVAC:FourPipeFanCoil,
    DC CRAH,                             !- Name
    Always On Discrete,                  !- Availability Schedule
    VariableFanVariableFlow,             !- Capacity Control Method
    36.0,                                !- Max Supply Air Flow {m3/s}  (~600 kW @ 14°C ΔT_air)
    0.2,                                 !- Low Speed Ratio
    0.5,                                 !- Medium Speed Ratio
    0,                                   !- Max OA Flow (no OA)
    ,                                    !- OA Schedule
    DC CRAH Air Inlet Node,              !- Air Inlet (= zone exhaust)
    DC CRAH Supply Air Node,             !- Air Outlet
    OutdoorAir:Mixer, DC CRAH OA Mixer,
    Fan:VariableVolume, DC CRAH Fan,
    Coil:Cooling:Water, DC CRAH Cooling Coil,
    0.030,                               !- Max Cold Water Flow {m3/s} (June08: 600→607 kW residual, was 0.024)
    0.0,                                 !- Min Cold Water Flow
    0.001,                               !- Cooling Convergence Tolerance
    Coil:Heating:Electric, DC CRAH Heating Coil,
    0, 0, 0.001,
    , , , , ;

  OutdoorAir:Mixer,
    DC CRAH OA Mixer,
    DC CRAH Mixed Air Node,
    DC CRAH OA Inlet Node,
    DC CRAH Relief Air Node,
    DC CRAH Air Inlet Node;

  OutdoorAir:NodeList, DC CRAH OA Inlet Node;

  ! Air path in FourPipeFanCoil (blow-through):
  !   OA Mixer → Fan → Cooling Coil → Heating Coil → Supply

  Fan:VariableVolume,
    DC CRAH Fan,
    Always On Discrete,
    0.65,                                !- Total Efficiency
    750,                                 !- Pressure Rise {Pa}
    36.0,                                !- Max Flow {m3/s}
    Fraction, 0.2, 0,
    0.93, 1.0,
    0.0407, 0.0, 0.9821, -0.0228, 0,
    DC CRAH Mixed Air Node,              !- Inlet
    DC CRAH Fan Outlet Node,             !- Outlet
    HVAC;

  Coil:Cooling:Water,
    DC CRAH Cooling Coil,
    Always On Discrete,
    0.030,                               !- Design Water Flow (June08: was 0.024, matched to re-sized loop)
    36.0,                                !- Design Air Flow
    8.0,                                 !- Design Inlet Water Temp (matches Room CHW supply)
    32.0,                                !- Design Inlet Air Temp (zone return)
    18.0,                                !- Design Outlet Air Temp
    0.012, 0.010,
    DC CRAH Coil Water Inlet Node,
    DC CRAH Coil Water Outlet Node,
    DC CRAH Fan Outlet Node,             !- Air Inlet
    DC CRAH Cool Coil Air Out Node,      !- Air Outlet
    SimpleAnalysis, CrossFlow;

  Coil:Heating:Electric,
    DC CRAH Heating Coil,
    Always On Discrete,
    1.0,
    1.0,                                 !- Nominal Capacity {W} (disabled — DC never heats)
    DC CRAH Cool Coil Air Out Node,
    DC CRAH Supply Air Node;

  SetpointManager:Scheduled,
    DC CRAH Supply Air SPM, Temperature,
    DC CRAH Supply Air Temp Sch, DC CRAH Supply Air Node;

  Schedule:Compact,
    DC CRAH Supply Air Temp Sch, Temperature,
    Through: 12/31, For: AllDays, Until: 24:00, 18.0;

  ZoneControl:Thermostat,
    DataCenter ZN Thermostat,
    DataCenter ZN,
    DC Thermostat Schedule,
    ThermostatSetpoint:DualSetpoint,
    DC Thermostat 1,
    ,,,,,, 0;

  ScheduleTypeLimits, TstatType, 0, 4, DISCRETE;

  ThermostatSetpoint:DualSetpoint,
    DC Thermostat 1,
    DC HTGSETP,
    DC CLGSETP;

  ! ── Warm-Water Plant Loop ─────────────────────────────────
  !
  !  Diagram topology:
  !    Supply side: FluidCooler:SingleSpeed (Dry Cooler)
  !                 Entering water: ~47°C (FWS return from ITE)
  !                 Leaving water setpoint: 45°C
  !                 Design ambient: 40°C (diagram max)
  !    Demand side: ElectricEquipment:ITE:LiquidCooled
  !
  !  Note: Chiller or EvaporativeFluidCooler could replace the dry cooler
  !  on the supply branch — see diagram's three rejection options.

  PlantLoop,
    WW Loop,                  !- Name
    Water,                    !- Fluid Type
    ,                         !- User Defined Fluid
    WW Loop Operation,        !- Plant Equipment Operation Scheme Name
    WW Supply Outlet Node,    !- Loop Temperature Setpoint Node
    100,                      !- Max Loop Temperature {C}
    20,                       !- Min Loop Temperature {C}
    0.250,                    !- Max Loop Volume Flow Rate {m3/s}
    0,                        !- Min Loop Volume Flow Rate {m3/s}
    Autocalculate,            !- Plant Loop Volume {m3}
    WW Supply Inlet Node,     !- Plant Side Inlet Node
    WW Supply Outlet Node,    !- Plant Side Outlet Node
    WW Supply Branches,       !- Plant Side Branch List
    WW Supply Connectors,     !- Plant Side Connector List
    WW Demand Inlet Node,     !- Demand Side Inlet Node
    WW Demand Outlet Node,    !- Demand Side Outlet Node
    WW Demand Branches,       !- Demand Side Branch List
    WW Demand Connectors,     !- Demand Side Connector List
    Optimal,                  !- Load Distribution Scheme
    ,                         !- Availability Manager List Name
    SingleSetpoint,           !- Plant Loop Demand Calculation Scheme
    None,                     !- Common Pipe Simulation
    None;                     !- Pressure Simulation Type

  SetpointManager:Scheduled,
    WW Supply Setpoint Manager,
    Temperature,
    WW FWS Supply Temp Setpoint,
    WW Supply Outlet Node;

  ! Supply side: pump + dry cooler (FluidCooler:SingleSpeed)

  BranchList,
    WW Supply Branches,
    WW Supply Inlet Branch,
    WW Dry Cooler Branch,
    WW Supply Outlet Branch;

  ConnectorList,
    WW Supply Connectors,
    Connector:Splitter, WW Supply Splitter,
    Connector:Mixer,   WW Supply Mixer;

  Connector:Splitter,
    WW Supply Splitter,
    WW Supply Inlet Branch,
    WW Dry Cooler Branch;

  Connector:Mixer,
    WW Supply Mixer,
    WW Supply Outlet Branch,
    WW Dry Cooler Branch;

  Branch,
    WW Supply Inlet Branch,
    ,
    Pump:ConstantSpeed, WW Pump,
    WW Supply Inlet Node, WW Pump Outlet Node;

  Branch,
    WW Dry Cooler Branch,
    ,
    FluidCooler:SingleSpeed, WW Dry Cooler,
    WW DC Inlet Node, WW DC Outlet Node;

  Branch,
    WW Supply Outlet Branch,
    ,
    Pipe:Adiabatic, WW Supply Outlet Pipe,
    WW Supply Outlet Pipe Inlet, WW Supply Outlet Node;

  Pump:ConstantSpeed,
    WW Pump,
    WW Supply Inlet Node,     !- Inlet
    WW Pump Outlet Node,      !- Outlet
    0.250,                    !- Rated Flow Rate {m3/s}
    200000,                   !- Rated Pump Head {Pa}
    Autosize,                 !- Rated Power {W}
    0.87,                     !- Motor Efficiency
    0.0,                      !- Fraction of Motor Inefficiencies to Fluid
    Intermittent,             !- Pump Control Type
    ;                         !- Pump Flow Rate Schedule

  ! Dry Cooler — ambient −10°C to 40°C
  ! Sized for: entering water 47°C (FWS return), design air 40°C, 3 MW nominal
  ! At Tampa July ambient ~30°C: approach = 47−30 = 17°C — well within capacity
  FluidCooler:SingleSpeed,
    WW Dry Cooler,            !- Name
    WW DC Inlet Node,         !- Water Inlet Node Name
    WW DC Outlet Node,        !- Water Outlet Node Name
    NominalCapacity,          !- Performance Input Method
    ,                         !- Design Air Flow Rate U-factor Times Area Value {W/K}
    3000000,                  !- Nominal Capacity {W}
    50.0,                     !- Design Entering Water Temperature {C}  (FWS return: 45°C supply + 5°C rise)
    40.0,                     !- Design Entering Air Temperature {C}  (diagram max ambient)
    25.0,                     !- Design Entering Air Wetbulb Temperature {C}
    0.225,                    !- Design Water Flow Rate {m3/s}
    Autosize,                 !- Design Air Flow Rate {m3/s}
    Autosize;                 !- Design Air Flow Rate Fan Power {W}

  Pipe:Adiabatic,
    WW Supply Outlet Pipe,
    WW Supply Outlet Pipe Inlet,
    WW Supply Outlet Node;

  ! Demand side: ITE liquid cooled object

  BranchList,
    WW Demand Branches,
    WW Demand Inlet Branch,
    WW ITE LiquidCooled Branch,
    WW Demand Outlet Branch;

  ConnectorList,
    WW Demand Connectors,
    Connector:Splitter, WW Demand Splitter,
    Connector:Mixer,   WW Demand Mixer;

  Connector:Splitter,
    WW Demand Splitter,
    WW Demand Inlet Branch,
    WW ITE LiquidCooled Branch;

  Connector:Mixer,
    WW Demand Mixer,
    WW Demand Outlet Branch,
    WW ITE LiquidCooled Branch;

  Branch,
    WW Demand Inlet Branch,
    ,
    Pipe:Adiabatic, WW Demand Inlet Pipe,
    WW Demand Inlet Node, WW Demand Inlet Pipe Outlet;

  Branch,
    WW ITE LiquidCooled Branch,
    ,
    ElectricEquipment:ITE:LiquidCooled, DC Warm Water ITE,
    ITE FWS Inlet Node, ITE FWS Outlet Node;

  Branch,
    WW Demand Outlet Branch,
    ,
    Pipe:Adiabatic, WW Demand Outlet Pipe,
    WW Demand Outlet Pipe Inlet, WW Demand Outlet Node;

  Pipe:Adiabatic,
    WW Demand Inlet Pipe,
    WW Demand Inlet Node,
    WW Demand Inlet Pipe Outlet;

  Pipe:Adiabatic,
    WW Demand Outlet Pipe,
    WW Demand Outlet Pipe Inlet,
    WW Demand Outlet Node;

  ! Equipment operation scheme

  PlantEquipmentOperationSchemes,
    WW Loop Operation,
    PlantEquipmentOperation:CoolingLoad,
    WW Cooling Op,
    Always On Discrete;

  PlantEquipmentOperation:CoolingLoad,
    WW Cooling Op,
    0, 99999999,
    WW Cooling Equipment List;

  PlantEquipmentList,
    WW Cooling Equipment List,
    FluidCooler:SingleSpeed, WW Dry Cooler;

  ! ════════════════════════════════════════════════════════════════
  !  SECONDARY ROOM CHW LOOP  (W3 — for residual zone load)
  !
  !  Real warm-water DCs (45°C FWS) cannot cool air to 18–22°C with
  !  the warm-water loop itself.  A separate small air-cooled chiller
  !  serves a "Room CHW" loop at 8°C, which feeds the DC CRAH coil
  !  that handles:
  !    - 20% rack air leakage (intended design — handled by CRAH, not the liquid loop)
  !    - UPS losses to zone
  !    - Lights + envelope
  !  June08: peak residual ≈ 607 kW.  Chiller re-sized to 1000 kW nameplate
  !  (covers 607 kW after the ~0.77 hot-OA CapFT de-rate, ~25% margin).
  !  Chiller is air-cooled → WUE stays at 0 (no makeup water).
  ! ════════════════════════════════════════════════════════════════

  PlantLoop,
    Room CHW Loop,                                   !- Name
    Water,                                           !- Fluid Type
    ,                                                !- User Defined Fluid
    Room CHW Loop Operation,                         !- Plant Equipment Operation Scheme Name
    Room CHW Supply Outlet Node,                     !- Loop Temperature Setpoint Node
    30,                                              !- Maximum Loop Temperature {C}
    2,                                               !- Minimum Loop Temperature {C}
    0.035,                                           !- Maximum Loop Volume Flow Rate {m3/s}  (June08: sized for re-sized chiller, was 0.030)
    0,                                               !- Minimum Loop Volume Flow Rate {m3/s}
    Autocalculate,                                   !- Plant Loop Volume {m3}
    Room CHW Supply Inlet Node,                      !- Plant Side Inlet Node
    Room CHW Supply Outlet Node,                     !- Plant Side Outlet Node
    Room CHW Supply Branches,                        !- Plant Side Branch List
    Room CHW Supply Connectors,                      !- Plant Side Connector List
    Room CHW Demand Inlet Node,                      !- Demand Side Inlet Node
    Room CHW Demand Outlet Node,                     !- Demand Side Outlet Node
    Room CHW Demand Branches,                        !- Demand Side Branch List
    Room CHW Demand Connectors,                      !- Demand Side Connector List
    Optimal,                                         !- Load Distribution Scheme
    ,                                                !- Availability Manager List Name
    SingleSetpoint,                                  !- Plant Loop Demand Calculation Scheme
    None,                                            !- Common Pipe Simulation
    None;                                            !- Pressure Simulation Type

  Sizing:Plant,
    Room CHW Loop, Cooling, 8.0, 6.0,
    NonCoincident, 1, None;

  SetpointManager:Scheduled,
    Room CHW Setpoint Manager, Temperature,
    Room CHW Supply Temp Sch, Room CHW Supply Outlet Node;

  Schedule:Compact,
    Room CHW Supply Temp Sch, Temperature,
    Through: 12/31, For: AllDays, Until: 24:00, 8.0;

  ! ─── Room CHW supply side: pump + air-cooled chiller ───

  BranchList,
    Room CHW Supply Branches,
    Room CHW Supply Inlet Branch,
    Room CHW Chiller Branch,
    Room CHW Supply Outlet Branch;

  ConnectorList,
    Room CHW Supply Connectors,
    Connector:Splitter, Room CHW Supply Splitter,
    Connector:Mixer,   Room CHW Supply Mixer;

  Connector:Splitter,
    Room CHW Supply Splitter,
    Room CHW Supply Inlet Branch,
    Room CHW Chiller Branch;

  Connector:Mixer,
    Room CHW Supply Mixer,
    Room CHW Supply Outlet Branch,
    Room CHW Chiller Branch;

  Branch,
    Room CHW Supply Inlet Branch, ,
    Pump:ConstantSpeed, Room CHW Pump,
    Room CHW Supply Inlet Node, Room CHW Pump Outlet Node;

  Branch,
    Room CHW Chiller Branch, ,
    Chiller:Electric:EIR, Room Chiller,
    Room Chiller CHW Inlet Node, Room Chiller CHW Outlet Node;

  Branch,
    Room CHW Supply Outlet Branch, ,
    Pipe:Adiabatic, Room CHW Supply Outlet Pipe,
    Room CHW Supply Outlet Pipe Inlet, Room CHW Supply Outlet Node;

  Pump:ConstantSpeed,
    Room CHW Pump,
    Room CHW Supply Inlet Node, Room CHW Pump Outlet Node,
    0.035,                                           !- Rated Flow {m3/s} (June08: was 0.030, matches loop)
    150000,                                          !- Rated Head {Pa}
    Autosize,                                        !- Rated Power {W}
    0.87, 0.0, Intermittent, ;

  ! Air-cooled chiller curves
  !   CapFT  = 0.95 + 0.02·Tchws − 0.01·Toa
  !   EIRFT  = 0.50 − 0.02·Tchws + 0.025·Toa
  !   EIRPLR = 0.15 + 0.55·PLR + 0.30·PLR²

  Curve:Biquadratic,
    RoomCh CAPFT, 0.95, 0.02, 0.0, -0.01, 0.0, 0.0,
    3.0, 15.0,                                       !- Tchws min/max {C}
    10.0, 46.0;                                      !- Toa min/max {C}

  Curve:Biquadratic,
    RoomCh EIRFT, 0.50, -0.02, 0.0, 0.025, 0.0, 0.0,
    3.0, 15.0,
    10.0, 46.0;

  Curve:Quadratic,
    RoomCh EIRPLR, 0.15, 0.55, 0.30, 0.1, 1.0;

  ! June08 re-size for the 20% air-side leakage load:
  !   Peak residual = 20%×2143 kW leak (429) + UPS loss (137) = 566 kW,
  !   + ~41 kW in-airstream CRAH fan heat  →  ~607 kW peak coil load.
  !   Air-cooled CapFT (0.95+0.02·Tchws−0.01·Toa) ≈ 0.77 at the 34°C Tampa design OA,
  !   so deliverable = nameplate×0.77.  Need 607/0.77 ≈ 790 kW; with ~25% margin → 1000 kW.
  !   (Old 600 kW unit delivered only ~460 kW at hot OA → saturated → zone runaway to 176°C.)
  Chiller:Electric:EIR,
    Room Chiller,                                    !- Name
    1000000,                                         !- Reference Capacity {W} (1.0 MW; was 600 kW — covers 607 kW peak after hot-OA de-rate)
    3.2,                                             !- Reference COP (air-cooled scroll, typical)
    8.0,                                             !- Reference Leaving CHW Temp {C}
    35.0,                                            !- Reference Entering Condenser Temp {C} (outdoor air)
    0.030,                                           !- Reference CHW Flow {m3/s} (607 kW @ ~5°C ΔT; within 0.035 loop)
    Autosize,                                        !- Reference Condenser Flow (unused for AirCooled)
    RoomCh CAPFT, RoomCh EIRFT, RoomCh EIRPLR,
    0.1, 1.0, 1.0, 0.2,
    Room Chiller CHW Inlet Node,                     !- CHW Inlet
    Room Chiller CHW Outlet Node,                    !- CHW Outlet
    Room Chiller Air Inlet Node,                     !- Condenser Inlet (outdoor air node)
    Room Chiller Air Outlet Node,                    !- Condenser Outlet
    AirCooled,                                       !- Condenser Type
    0.04,                                            !- Condenser Fan Power Ratio (W/W, ~4% of capacity)
    1.0, 2.0, NotModulated;

  OutdoorAir:Node,
    Room Chiller Air Inlet Node;                     !- Pulls outdoor air for air-cooled condenser

  Pipe:Adiabatic,
    Room CHW Supply Outlet Pipe,
    Room CHW Supply Outlet Pipe Inlet, Room CHW Supply Outlet Node;

  ! ─── Room CHW demand side: CRAH coil + bypass ───

  BranchList,
    Room CHW Demand Branches,
    Room CHW Demand Inlet Branch,
    Room CHW CRAH Coil Branch,
    Room CHW Demand Bypass Branch,
    Room CHW Demand Outlet Branch;

  ConnectorList,
    Room CHW Demand Connectors,
    Connector:Splitter, Room CHW Demand Splitter,
    Connector:Mixer,   Room CHW Demand Mixer;

  Connector:Splitter,
    Room CHW Demand Splitter,
    Room CHW Demand Inlet Branch,
    Room CHW CRAH Coil Branch,
    Room CHW Demand Bypass Branch;

  Connector:Mixer,
    Room CHW Demand Mixer,
    Room CHW Demand Outlet Branch,
    Room CHW CRAH Coil Branch,
    Room CHW Demand Bypass Branch;

  Branch,
    Room CHW Demand Inlet Branch, ,
    Pipe:Adiabatic, Room CHW Demand Inlet Pipe,
    Room CHW Demand Inlet Node, Room CHW Demand Inlet Pipe Outlet;

  Branch,
    Room CHW CRAH Coil Branch, ,
    Coil:Cooling:Water, DC CRAH Cooling Coil,
    DC CRAH Coil Water Inlet Node, DC CRAH Coil Water Outlet Node;

  Branch,
    Room CHW Demand Bypass Branch, ,
    Pipe:Adiabatic, Room CHW Demand Bypass Pipe,
    Room CHW Demand Bypass Inlet Node, Room CHW Demand Bypass Outlet Node;

  Branch,
    Room CHW Demand Outlet Branch, ,
    Pipe:Adiabatic, Room CHW Demand Outlet Pipe,
    Room CHW Demand Outlet Pipe Inlet, Room CHW Demand Outlet Node;

  Pipe:Adiabatic, Room CHW Demand Inlet Pipe,
    Room CHW Demand Inlet Node, Room CHW Demand Inlet Pipe Outlet;
  Pipe:Adiabatic, Room CHW Demand Bypass Pipe,
    Room CHW Demand Bypass Inlet Node, Room CHW Demand Bypass Outlet Node;
  Pipe:Adiabatic, Room CHW Demand Outlet Pipe,
    Room CHW Demand Outlet Pipe Inlet, Room CHW Demand Outlet Node;

  PlantEquipmentOperationSchemes,
    Room CHW Loop Operation,
    PlantEquipmentOperation:CoolingLoad,
    Room CHW Cooling Op, Always On Discrete;

  PlantEquipmentOperation:CoolingLoad,
    Room CHW Cooling Op, 0, 99999999, Room CHW Cooling Equipment List;

  PlantEquipmentList,
    Room CHW Cooling Equipment List,
    Chiller:Electric:EIR, Room Chiller;

  ! ── Outputs ───────────────────────────────────────────────

  Output:VariableDictionary, IDF, Unsorted;

  Output:Variable, DC Warm Water ITE, ITE Liquid Cooled CPU Electricity Rate,            Hourly;
  Output:Variable, DC Warm Water ITE, ITE Liquid Cooled Heat Extraction Rate,            Hourly;
  Output:Variable, DC Warm Water ITE, ITE Liquid Cooled Zone Sensible Heat Gain Rate,    Hourly;
  Output:Variable, DC Warm Water ITE, ITE Liquid Cooled Facility Water Supply Temperature,   Hourly;
  Output:Variable, DC Warm Water ITE, ITE Liquid Cooled Facility Water Return Temperature,   Hourly;
  Output:Variable, DC Warm Water ITE, ITE Liquid Cooled Facility Water Mass Flow Rate,       Hourly;
  Output:Variable, DC Warm Water ITE, ITE Liquid Cooled Rack Coolant Supply Temperature,     Hourly;
  Output:Variable, DC Warm Water ITE, ITE Liquid Cooled Rack Coolant Return Temperature,     Hourly;
  Output:Variable, DC Warm Water ITE, ITE Liquid Cooled CDU Log Mean Temperature Difference, Hourly;
  Output:Variable, DC Warm Water ITE, ITE Liquid Cooled CDU Approach Temperature,            Hourly;
  Output:Variable, DC Warm Water ITE, ITE Liquid Cooled CDU Effectiveness,                   Hourly;
  Output:Variable, DC Warm Water ITE, ITE Liquid Cooled Peak Chip Junction Temperature,      Hourly;

  Output:Variable, *, Zone Mean Air Temperature, TimeStep;

  ! CRAH + secondary chiller variables
  Output:Variable, *, Fan Electricity Rate, Hourly;
  Output:Variable, *, Cooling Coil Total Cooling Rate, Hourly;
  Output:Variable, *, Chiller Electricity Rate, Hourly;
  Output:Variable, *, Chiller COP, Hourly;
  Output:Variable, *, Pump Electricity Rate, Hourly;
  Output:Variable, *, Fluid Cooler Fan Electricity Rate, Hourly;

  Output:Meter, Electricity:Facility, Annual;
  Output:Meter, Cooling:Electricity, Annual;
  Output:Meter, Fans:Electricity, Annual;
  Output:Meter, Heat Rejection:Electricity, Annual;
  Output:Meter, Pumps:Electricity, Annual;
  Output:Meter, DistrictCooling:Facility, Annual;   ! Should be ~0 after CRAH
  Output:Meter, DistrictHeating:Facility, Annual;

  OutputControl:Table:Style, HTML;
  Output:Table:SummaryReports, AllSummary;
  Output:SQLite, SimpleAndTabular;

  ! ============================================================
  ! Added 2026-08-31: hourly meters for PUE / WUE / EUE time series
  ! ============================================================
  Output:Meter, Electricity:Facility, Hourly;
  Output:Meter, InteriorEquipment:Electricity, Hourly;
  Output:Meter, ITE-CPU:InteriorEquipment:Electricity, Hourly;
  Output:Meter, ITE-Fans:InteriorEquipment:Electricity, Hourly;
