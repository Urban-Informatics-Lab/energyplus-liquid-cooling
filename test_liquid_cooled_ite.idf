  ! ── Chiller Performance Curves ───────────────────────────────
  !  All three curves are normalized to 1.0 at reference conditions:
  !    CHW leaving = 12°C,  CW entering = 29.44°C
  !
  !  CapFuncTemp = 1.3488 + 0.02·Tchws − 0.02·Tcwe
  !    (+2%/°C warmer CHW supply, −2%/°C warmer CW entering)
  !  EIRFuncTemp = 0.4768 − 0.03·Tchws + 0.03·Tcwe
  !    (better COP at warmer CHW supply, worse COP at warmer CW)
  !  EIRFuncPLR  = 0.1 + 0.5·PLR + 0.4·PLR²  (centrifugal part-load shape)

  Curve:Biquadratic,
    ChillerCAPFT,            !- Name
    1.3488, 0.02, 0.0, -0.02, 0.0, 0.0,
    5.0, 20.0,               !- CHW leaving temp min/max {C}
    18.0, 40.0;              !- CW entering temp min/max {C}

  Curve:Biquadratic,
    ChillerEIRFT,            !- Name
    0.4768, -0.03, 0.0, 0.03, 0.0, 0.0,
    5.0, 20.0,               !- CHW leaving temp min/max {C}
    18.0, 40.0;              !- CW entering temp min/max {C}

  Curve:Quadratic,
    ChillerEIRFPLR,          !- Name
    0.1, 0.5, 0.4,
    0.1, 1.0;                !- PLR min/max

