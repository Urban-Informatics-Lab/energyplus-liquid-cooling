    0,                                   !- Maximum Hot Water Flow Rate (unused for elec)
    0,                                   !- Minimum Hot Water Flow Rate (unused)
    0.001,                               !- Heating Convergence Tolerance
    ,                                    !- Availability Manager List Name
    ,                                    !- Design Specification ZoneHVAC Sizing Object
    ,                                    !- Supply Air Fan Operating Mode Schedule
    ,                                    !- Minimum Supply Air Temperature in Cooling Mode {C}
    ;                                    !- Maximum Supply Air Temperature in Heating Mode {C}

