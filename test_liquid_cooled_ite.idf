    18.0,                        !- Minimum Setpoint Temperature {C}  (chiller protection floor)
    CW Loop Supply Outlet Node;  !- Setpoint Node Name

  Sizing:Plant,
    CW Loop, Condenser, 29.0, 6.0;

  ! Supply side: pump + cooling tower

  BranchList,
    CW Supply Branches,
    CW Supply Inlet Branch,
    CW Tower Branch,
    CW Supply Outlet Branch;

  ConnectorList,
    CW Supply Connectors,
    Connector:Splitter, CW Supply Splitter,
    Connector:Mixer,   CW Supply Mixer;

  Connector:Splitter,
    CW Supply Splitter,
    CW Supply Inlet Branch,
    CW Tower Branch;

  Connector:Mixer,
    CW Supply Mixer,
    CW Supply Outlet Branch,
    CW Tower Branch;

  Branch,
    CW Supply Inlet Branch, ,
    Pump:ConstantSpeed, CW Pump,
    CW Supply Inlet Node, CW Pump Outlet Node;

  Branch,
    CW Tower Branch, ,
    CoolingTower:SingleSpeed, CW Cooling Tower,
    CW Tower Inlet Node, CW Tower Outlet Node;

  Branch,
    CW Supply Outlet Branch, ,
    Pipe:Adiabatic, CW Supply Outlet Pipe,
    CW Supply Outlet Pipe Inlet, CW Loop Supply Outlet Node;

  Pump:ConstantSpeed,
    CW Pump,
    CW Supply Inlet Node,    !- Inlet
    CW Pump Outlet Node,     !- Outlet
    0.250,                   !- Rated Flow Rate {m3/s}
    150000,                  !- Rated Pump Head {Pa}
    Autosize,                !- Rated Power {W}
    0.87,                    !- Motor Efficiency
    0.0,                     !- Fraction Motor Inefficiencies to Fluid
    Intermittent,            !- Pump Control Type
    ;                        !- Pump Flow Rate Schedule

  ! Wet cooling tower: NominalCapacity method
  !   Nominal capacity defined at: 35°C entering water, 29.44°C leaving water,
  !   25.56°C WB, 35°C DB (per EnergyPlus documentation).
  !   Sized for ~3.5 MW condenser duty (chiller + pump heat).
  !   Evaporation loss tracked → contributes to WUE.
  CoolingTower:SingleSpeed,
    CW Cooling Tower,        !- Name
    CW Tower Inlet Node,     !- Water Inlet Node Name
    CW Tower Outlet Node,    !- Water Outlet Node Name
    ,                        !- Design Water Flow Rate {m3/s}  (blank = NominalCapacity)
    Autosize,                !- Design Air Flow Rate {m3/s}
    Autosize,                !- Design Fan Power {W}
    ,                        !- Design U-Factor Times Area Value {W/K}  (blank = NominalCapacity)
    0.0,                     !- Free Convection Regime Air Flow Rate {m3/s}
    0.1,                     !- Free Convection Air Flow Rate Sizing Factor
    0.0,                     !- Free Convection U-Factor Times Area Value {W/K}
    0.1,                     !- Free Convection U-Factor Times Area Sizing Factor
    NominalCapacity,         !- Performance Input Method
    1.25,                    !- Heat Rejection Capacity and Nominal Capacity Sizing Ratio
    3500000,                 !- Nominal Capacity {W}
    0.0,                     !- Free Convection Capacity {W}  (0 = no free convection)
    0.1,                     !- Free Convection Nominal Capacity Sizing Factor
    35.0,                    !- Design Inlet Air Dry-Bulb Temperature {C}
    25.6,                    !- Design Inlet Air Wet-Bulb Temperature {C}
    Autosize,                !- Design Approach Temperature {deltaC}
    Autosize,                !- Design Range Temperature {deltaC}
    0.0,                     !- Basin Heater Capacity {W/K}
    2.0,                     !- Basin Heater Setpoint Temperature {C}
    ,                        !- Basin Heater Operating Schedule Name
    SaturatedExit,           !- Evaporation Loss Mode
    0.2,                     !- Evaporation Loss Factor {percent/K}
    0.008,                   !- Drift Loss Percent
    ConcentrationRatio,      !- Blowdown Calculation Mode
    3.0,                     !- Blowdown Concentration Ratio
    ,                        !- Blowdown Makeup Water Usage Schedule Name
    ,                        !- Supply Water Storage Tank Name
    ,                        !- Outdoor Air Inlet Node Name
    FanCycling;              !- Capacity Control

  Pipe:Adiabatic,
    CW Supply Outlet Pipe,
    CW Supply Outlet Pipe Inlet,
    CW Loop Supply Outlet Node;

  ! Demand side: chiller condenser

  BranchList,
    CW Demand Branches,
    CW Demand Inlet Branch,
    CW Chiller Cond Branch,
    CW Demand Outlet Branch;

  ConnectorList,
    CW Demand Connectors,
    Connector:Splitter, CW Demand Splitter,
    Connector:Mixer,   CW Demand Mixer;

  Connector:Splitter,
    CW Demand Splitter,
    CW Demand Inlet Branch,
    CW Chiller Cond Branch;

  Connector:Mixer,
    CW Demand Mixer,
    CW Demand Outlet Branch,
    CW Chiller Cond Branch;

  Branch,
    CW Demand Inlet Branch, ,
    Pipe:Adiabatic, CW Demand Inlet Pipe,
    CW Demand Inlet Node, CW Demand Inlet Pipe Outlet;

  Branch,
    CW Chiller Cond Branch, ,
    Chiller:Electric:EIR, CHW Chiller,
    CHW Chiller CW Inlet Node, CHW Chiller CW Outlet Node;

  Branch,
    CW Demand Outlet Branch, ,
    Pipe:Adiabatic, CW Demand Outlet Pipe,
    CW Demand Outlet Pipe Inlet, CW Demand Outlet Node;

  Pipe:Adiabatic, CW Demand Inlet Pipe,
    CW Demand Inlet Node, CW Demand Inlet Pipe Outlet;
  Pipe:Adiabatic, CW Demand Outlet Pipe,
    CW Demand Outlet Pipe Inlet, CW Demand Outlet Node;

  PlantEquipmentOperationSchemes,
    CW Loop Operation,
    PlantEquipmentOperation:CoolingLoad,
    CW Cooling Op,
    Always On Discrete;

  PlantEquipmentOperation:CoolingLoad,
    CW Cooling Op,
    0, 99999999,
    CW Cooling Equipment List;

  PlantEquipmentList,
    CW Cooling Equipment List,
    CoolingTower:SingleSpeed, CW Cooling Tower;

  ! ── Outputs ──────────────────────────────────────────────────

  OutputControl:Table:Style, HTML;
  Output:VariableDictionary, IDF, Unsorted;
  Output:SQLite, SimpleAndTabular;
  Output:Table:SummaryReports, AllSummary;

  Output:Variable,
    LargeDataCenterHighITE StandaloneDataCenter ITE LiquidCooled 1,
    ITE Liquid Cooled CPU Electricity Rate, Hourly;
  Output:Variable,
    LargeDataCenterHighITE StandaloneDataCenter ITE LiquidCooled 1,
    ITE Liquid Cooled Heat Extraction Rate, Hourly;
  Output:Variable,
    LargeDataCenterHighITE StandaloneDataCenter ITE LiquidCooled 1,
    ITE Liquid Cooled Zone Sensible Heat Gain Rate, Hourly;
  Output:Variable,
    LargeDataCenterHighITE StandaloneDataCenter ITE LiquidCooled 1,
    ITE Liquid Cooled Facility Water Supply Temperature, Hourly;
  Output:Variable,
    LargeDataCenterHighITE StandaloneDataCenter ITE LiquidCooled 1,
    ITE Liquid Cooled Facility Water Return Temperature, Hourly;
  Output:Variable,
    LargeDataCenterHighITE StandaloneDataCenter ITE LiquidCooled 1,
    ITE Liquid Cooled Rack Coolant Supply Temperature, Hourly;
  Output:Variable,
    LargeDataCenterHighITE StandaloneDataCenter ITE LiquidCooled 1,
    ITE Liquid Cooled Rack Coolant Return Temperature, Hourly;
  Output:Variable,
    LargeDataCenterHighITE StandaloneDataCenter ITE LiquidCooled 1,
    ITE Liquid Cooled CDU Approach Temperature, Hourly;
  Output:Variable,
    LargeDataCenterHighITE StandaloneDataCenter ITE LiquidCooled 1,
    ITE Liquid Cooled Peak Chip Junction Temperature, Hourly;

  Output:Variable,
    LargeDataCenterHighITE StandaloneDataCenter ITE LiquidCooled 1,
    ITE Liquid Cooled Facility Water Mass Flow Rate, Hourly;

  Output:Variable, *, Chiller Electricity Rate, Hourly;
  Output:Variable, *, Chiller COP, Hourly;
  Output:Variable, *, Cooling Tower Fan Electricity Rate, Hourly;
  Output:Variable, *, Cooling Tower Water Evaporation Volume, Hourly;
  Output:Variable, *, Pump Electricity Rate, Hourly;
  Output:Variable, *, Zone Mean Air Temperature, Hourly;

  ! CRAH (zone residual cooling) variables
  Output:Variable, *, Fan Electricity Rate, Hourly;
  Output:Variable, *, Fan Air Mass Flow Rate, Hourly;
  Output:Variable, *, Cooling Coil Total Cooling Rate, Hourly;
  Output:Variable, *, Cooling Coil Sensible Cooling Rate, Hourly;
  Output:Variable, *, Fan Coil Total Cooling Rate, Hourly;
  Output:Variable, *, System Node Temperature, Hourly;

  Output:Variable, *, Facility Total Purchased Electricity Rate, Hourly;

  Output:Meter, Electricity:Facility, Annual;
  Output:Meter, Cooling:Electricity, Annual;
  Output:Meter, Fans:Electricity, Annual;
  Output:Meter, WaterSystems:Cooling, Annual;
  Output:Meter, DistrictCooling:Facility, Annual;   ! Should be ~0 — CRAH now handles residual
  Output:Meter, DistrictHeating:Facility, Annual;   ! Should be ~0
