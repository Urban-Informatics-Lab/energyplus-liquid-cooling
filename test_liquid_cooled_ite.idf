  ! ── ElectricEquipment:ITE:LiquidCooled ───────────────────────
  !  Chilled-water design:
  !    CHW supply (FWS) = 12°C,  CDU approach = 2°C → rack supply = 14°C
  !    Rack return ≈ 34°C  (Q_liquid / C_rack ≈ 20°C rise at 0.024 m³/s)
  !    Junction temp = rack_supply + Q_per_unit × R_jc
  !      NumUnits = 71 racks (~29 kW/rack); R_jc = 0.001 K/W (rack-level per IDD guidance)
  !      → q_per_unit ≈ 29 kW, ΔT_junc ≈ 29°C, T_junc ≈ 43°C

  ElectricEquipment:ITE:LiquidCooled,
    LargeDataCenterHighITE StandaloneDataCenter ITE LiquidCooled 1,  !- Name
    DataCenter,              !- Zone or Space Name
    Watts/Area,              !- Design Power Input Calculation Method
    ,                        !- Watts per Unit {W}
    71,                      !- Number of Units  (~30 kW/rack, 2.14 MW total)
    3844.69356,              !- Watts per Floor Area {W/m2}
    DataCenter Equipment_SCH,!- Design Power Input Schedule Name
    Always On Discrete,      !- CPU Loading Schedule Name
    ,                        !- CPU Power Input Function Curve (blank = linear f=load)
    12.0,                    !- Facility Water Design Supply Temperature {C}  (chilled water)
    0.097,                   !- Facility Water Design Volumetric Flow Rate {m3/s}  (2.036 MW / (ρ·cp·5°C))
    ITE FWS Inlet Node,      !- Facility Water Coolant Inlet Node Name
    ITE FWS Outlet Node,     !- Facility Water Coolant Outlet Node Name
    0.024,                   !- Rack Coolant Design Volumetric Flow Rate {m3/s}  (2.036 MW / (ρ·cp·20°C))
    14.0,                    !- Rack Coolant Design Supply Temperature {C}  (12+2=14°C)
    2.0,                     !- CDU Approach Temperature {deltaC}
    0.001,                   !- Thermal Resistance Junction to Coolant {K/W}  (rack-level)
    90.0,                    !- Maximum Junction Temperature {C}
    0.20,                    !- Air Side Heat Leakage Fraction (20% — moderate containment, no rear-door HX)
    0.94,                    !- UPS Efficiency
    1.0,                     !- Fraction of UPS Losses to Zone (UPS collocated in data hall)
    ITE-CPU,                 !- CPU End-Use Subcategory
    ITE-UPS;                 !- UPS End-Use Subcategory

