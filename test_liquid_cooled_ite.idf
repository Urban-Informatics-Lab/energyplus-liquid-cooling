! ============================================================
!  test_chilled_water_ite.idf
!
!  Chilled-Water Liquid-Cooled Data Center
!  ----------------------------------------
!  Same building/zone/schedules as liquid_cooled_dc.idf.
!  Plant: two-loop chilled-water system
!    CHW loop  : Chiller:Electric:EIR (COP 5.5, rated at 12°C / 29.44°C)
!                → ITE:LiquidCooled demand
!    CW loop   : CoolingTower:SingleSpeed (wet, evaporative)
!                → Chiller condenser demand
!
!  Design-point physics (at full load):
!    IT CPU power    ≈ 3,000 kW  (5382 W/m² × 557.4 m²)
!    Q_liquid        = CPU × 0.95  ≈ 2,850 kW  (5% air leakage)
!    CHW supply      = 12°C,  return ≈ 15°C  (ΔT ≈ 3°C, V̇ = 0.225 m³/s)
!    CDU approach    = 2°C   → rack supply = 14°C  (ASHRAE W4-class cold plate)
!    Rack return     ≈ 26°C  (Q / ṁ_rack·cp ≈ 12°C rise at 0.060 m³/s)
!    Chiller COP     ≈ 5.5 (rated) → ~6.1 at 12°C CHW (warmer than 6.67°C ref)
!    Condenser heat  ≈ 2,850 × (1+1/5.5) ≈ 3,368 kW → rejected by wet tower
!    CW supply       = 29°C,  CW return ≈ 35°C  (ΔT ≈ 6°C, V̇ = 0.220 m³/s)
!    Tower wet-bulb  = 25.6°C (Tampa design), approach ≈ 3.9°C → CW supply 29.5°C
!
!  C++ object: ElectricEquipment:ITE:LiquidCooled (ITE_LiquidCooled.cc/.hh)
!  HVAC:  ZoneHVAC:IdealLoadsAirSystem  (handles 5% air-side leakage)
!  Water: CoolingTower evaporation + drift + blowdown → WUE > 0
! ============================================================

  Version,26.1;

  Building,
    LargeDataCenterHighITE-ChilledWater,
    ,                        !- North Axis {deg}
    City,                    !- Terrain
    ,                        !- Loads Convergence Tolerance
    ,                        !- Temperature Convergence Tolerance
    ,                        !- Solar Distribution
    ,                        !- Maximum Number of Warmup Days
    ;                        !- Minimum Number of Warmup Days

  Timestep,6;

  SimulationControl,
    No,                      !- Do Zone Sizing Calculation
    No,                      !- Do System Sizing Calculation
    Yes,                     !- Do Plant Sizing Calculation
    No,                      !- Run Simulation for Sizing Periods
    Yes,                     !- Run Simulation for Weather File Run Periods
    No,                      !- Do HVAC Sizing Simulation for Sizing Periods
    1;                       !- Maximum Number of HVAC Sizing Simulation Passes

  HeatBalanceAlgorithm,ConductionTransferFunction,200;

  RunPeriod,
    Run Period 1,            !- Name
    1,                       !- Begin Month
    1,                       !- Begin Day of Month
    2026,                    !- Begin Year
    12,                      !- End Month
    31,                      !- End Day of Month
    2026,                    !- End Year
    Thursday,                !- Day of Week for Start Day
    No,                      !- Use Weather File Holidays and Special Days
    No,                      !- Use Weather File Daylight Saving Period
    No,                      !- Apply Weekend Holiday Rule
    Yes,                     !- Use Weather File Rain Indicators
    Yes;                     !- Use Weather File Snow Indicators

  ShadowCalculation,
    PolygonClipping,         !- Shading Calculation Method
    Periodic,                !- Shading Calculation Update Frequency Method
    20,                      !- Shading Calculation Update Frequency
    15000,                   !- Maximum Figures in Shadow Overlap Calculations
    SutherlandHodgman,       !- Polygon Clipping Algorithm
    512,                     !- Pixel Counting Resolution
    SimpleSkyDiffuseModeling,!- Sky Diffuse Modeling Algorithm
    No,                      !- Output External Shading Calculation Results
    No,                      !- Disable Self-Shading Within Shading Zone Groups
    No;                      !- Disable Self-Shading From Shading Zone Groups to Other Zones

  SurfaceConvectionAlgorithm:Inside,TARP;
  SurfaceConvectionAlgorithm:Outside,TARP;

  ! ── Site ─────────────────────────────────────────────────────

  Site:Location,
    Tampa-MacDill AFB_FL_USA,!- Name
    27.85,                   !- Latitude {deg}
    -82.52,                  !- Longitude {deg}
    -5,                      !- Time Zone {hr}
    8;                       !- Elevation {m}

  Site:GroundTemperature:FCfactorMethod,24.2,18.9,15.7,13.6,15.5,17.1,21.2,26.9,27.6,27.9,27.4,26.2;

  Site:WaterMainsTemperature,
    Correlation,             !- Calculation Method
    ,                        !- Temperature Schedule Name
    21.85,                   !- Annual Average Outdoor Air Temperature {C}
    14.3;                    !- Maximum Difference In Monthly Average Outdoor Air Temperatures {deltaC}

  SizingPeriod:DesignDay,
    Tampa-MacDill.AFB_FL_USA Ann Clg .4% Condns DB=>MWB,
    8, 21, SummerDesignDay,
    33.9, 7.9, DefaultMultipliers, ,
    Wetbulb, 25.1, , , , ,
    101229, 3.1, 270, No, No, No,
    ASHRAETau, , , 0.491, 2.016, , , FullResetAtBeginEnvironment;

  SizingPeriod:DesignDay,
    Tampa-MacDill.AFB_FL_USA Ann Htg 99.6% Condns DB,
    1, 21, WinterDesignDay,
    4.6, 0, DefaultMultipliers, ,
    Wetbulb, 4.6, , , , ,
    101229, 2.5, 10, No, No, No,
    ASHRAEClearSky, , , , , 0, , FullResetAtBeginEnvironment;

  GlobalGeometryRules,
    UpperLeftCorner,         !- Starting Vertex Position
    Counterclockwise,        !- Vertex Entry Direction
    Relative,                !- Coordinate System
    Relative,                !- Daylighting Reference Point Coordinate System
    Relative;                !- Rectangular Surface Coordinate System

  ! ── Zone & Space ─────────────────────────────────────────────

  Zone,
    DataCenter ZN,           !- Name
    -0, 0, 0, 0,             !- North Axis, X, Y, Z Origin
    , 1, , , , , , Yes;      !- Type, Multiplier, ...

  Space,
    DataCenter,              !- Name
    DataCenter ZN,           !- Zone Name
    , , ,                    !- Ceiling Height, Volume, Floor Area
    LargeDataCenterHighITE StandaloneDataCenter;  !- Space Type

  SpaceList,
    LargeDataCenterHighITE StandaloneDataCenter,
    DataCenter;

